{
  "name": "@omnisearch/mcp-server",
  "version": "0.2.0",
  "description": "Universal multi-provider web search MCP server \u2014 Brave, Anthropic, OpenAI, Moonshot \u2014 with LRU caching, per-provider rate limiting, and fallback chains",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "bin": {
    "omnisearch": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "openai": "^5.0.0",
    "zod": "^4.1.8"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": ">=0.55.0 <1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "web-search",
    "opencode",
    "kilocode",
    "brave",
    "moonshot",
    "model-context-protocol"
  ],
  "license": "MIT"
}
